<?xml version="1.0" encoding="utf-8"?>
<!-- Khung một dòng tin nhắn gửi, căn về phía bên phải. -->
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    android:gravity="end"
    android:orientation="horizontal"
    android:paddingStart="48dp">

    <!-- Bong bóng nền xanh, tự mở rộng theo nội dung. -->
    <com.google.android.material.card.MaterialCardView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:cardBackgroundColor="@color/roomly_primary"
        app:cardCornerRadius="16dp"
        app:cardElevation="0dp"
        app:strokeWidth="0dp">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="12dp">

            <!-- Nội dung tin nhắn, có thể xuống nhiều dòng. -->
            <TextView
                android:id="@+id/tv_message_content"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Chào bạn, phòng này còn trống không?"
                android:textColor="@color/roomly_surface"
                android:textSize="14sp" />

            <!-- Thời gian gửi nằm dưới nội dung. -->
            <TextView
                android:id="@+id/tv_message_time"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="end"
                android:layout_marginTop="6dp"
                android:text="09:30"
                android:textColor="@color/roomly_surface"
                android:textSize="11sp" />

        </LinearLayout>

    </com.google.android.material.card.MaterialCardView>

</LinearLayout>