<?xml version="1.0" encoding="utf-8"?>
<!-- Form yêu cầu đặt lại mật khẩu, có thể cuộn khi bàn phím mở. -->
<androidx.core.widget.NestedScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/roomly_background"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <!-- Quay lại đăng nhập. -->
        <androidx.appcompat.widget.AppCompatImageButton
            android:id="@+id/btn_forgot_password_back"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Quay lại"
            android:padding="12dp"
            android:src="@drawable/ic_arrow_back"
            app:tint="@color/roomly_primary" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="Quên mật khẩu?"
            android:textColor="@color/roomly_text_primary"
            android:textSize="26sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:lineSpacingExtra="4dp"
            android:text="Nhập email bạn đã dùng để đăng ký tài khoản."
            android:textColor="@color/roomly_text_secondary"
            android:textSize="14sp" />

        <!-- Email nhận liên kết đặt lại mật khẩu. -->
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/layout_forgot_password_email"
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="32dp"
            android:hint="Email"
            app:boxBackgroundColor="@color/roomly_surface"
            app:boxCornerRadiusBottomEnd="12dp"
            app:boxCornerRadiusBottomStart="12dp"
            app:boxCornerRadiusTopEnd="12dp"
            app:boxCornerRadiusTopStart="12dp">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/edt_forgot_password_email"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:autofillHints="emailAddress"
                android:imeOptions="actionDone"
                android:inputType="textEmailAddress"
                android:singleLine="true"
                android:textColor="@color/roomly_text_primary"
                android:textSize="14sp" />

        </com.google.android.material.textfield.TextInputLayout>

        <!-- Lỗi kết nối hoặc yêu cầu thất bại. -->
        <TextView
            android:id="@+id/tv_forgot_password_error"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:accessibilityLiveRegion="polite"
            android:textColor="#B3261E"
            android:textSize="13sp"
            android:visibility="gone" />

        <!-- Thông báo chỉ hiện sau khi API tiếp nhận yêu cầu. -->
        <TextView
            android:id="@+id/tv_forgot_password_result"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:accessibilityLiveRegion="polite"
            android:lineSpacingExtra="4dp"
            android:text="Nếu email này có tài khoản, bạn sẽ nhận được hướng dẫn đặt lại mật khẩu. Vui lòng kiểm tra cả thư mục spam."
            android:textColor="@color/roomly_primary"
            android:textSize="14sp"
            android:visibility="gone" />

        <ProgressBar
            android:id="@+id/progress_forgot_password"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="16dp"
            android:indeterminateTint="@color/roomly_primary"
            android:visibility="gone" />

        <!-- Gửi yêu cầu khôi phục mật khẩu. -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_request_password_reset"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:minHeight="52dp"
            android:text="Gửi yêu cầu"
            android:textAllCaps="false"
            android:textColor="@color/roomly_surface"
            android:textSize="16sp"
            app:backgroundTint="@color/roomly_primary"
            app:cornerRadius="12dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_forgot_password_login"
            style="@style/Widget.MaterialComponents.Button.TextButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:minHeight="48dp"
            android:text="Quay lại đăng nhập"
            android:textAllCaps="false"
            android:textColor="@color/roomly_primary" />

    </LinearLayout>

</androidx.core.widget.NestedScrollView>