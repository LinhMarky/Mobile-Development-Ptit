<?xml version="1.0" encoding="utf-8"?>
<!-- Màn hình danh sách hội thoại và trạng thái khách. -->
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/roomly_background"
    android:paddingStart="20dp"
    android:paddingEnd="20dp">

    <!-- Tiêu đề màn hình. -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:text="Tin nhắn"
        android:textColor="@color/roomly_text_primary"
        android:textSize="26sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="Các cuộc trò chuyện của bạn"
        android:textColor="@color/roomly_text_secondary"
        android:textSize="14sp" />

    <!-- Vùng danh sách và các trạng thái thông báo. -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="20dp">

        <!-- Danh sách hội thoại. -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rv_conversations"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:paddingBottom="16dp"
            android:visibility="gone" />

        <!-- Hiển thị khi đã đăng nhập nhưng chưa có hội thoại. -->
        <LinearLayout
            android:id="@+id/layout_messages_empty"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:gravity="center"
            android:padding="24dp"
            android:visibility="gone">

            <ImageView
                android:layout_width="64dp"
                android:layout_height="64dp"
                android:src="@drawable/ic_chat"
                android:importantForAccessibility="no"
                app:tint="@color/roomly_primary" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:gravity="center"
                android:text="Bạn chưa có tin nhắn"
                android:textColor="@color/roomly_text_primary"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:gravity="center"
                android:lineSpacingExtra="4dp"
                android:text="Các cuộc trò chuyện của bạn sẽ xuất hiện ở đây."
                android:textColor="@color/roomly_text_secondary"
                android:textSize="14sp" />

        </LinearLayout>

        <!-- Hiển thị khi người dùng chưa đăng nhập. -->
        <ScrollView
            android:id="@+id/layout_messages_guest"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center"
                android:padding="24dp">

                <ImageView
                    android:layout_width="64dp"
                    android:layout_height="64dp"
                    android:src="@drawable/ic_chat"
                    android:importantForAccessibility="no"
                    app:tint="@color/roomly_primary" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:gravity="center"
                    android:text="Đăng nhập để xem tin nhắn"
                    android:textColor="@color/roomly_text_primary"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:gravity="center"
                    android:lineSpacingExtra="4dp"
                    android:text="Đăng nhập để xem các cuộc trò chuyện và trao đổi về phòng bạn quan tâm."
                    android:textColor="@color/roomly_text_secondary"
                    android:textSize="14sp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_messages_login"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="48dp"
                    android:layout_marginTop="24dp"
                    android:text="Đăng nhập"
                    android:textAllCaps="false"
                    android:textColor="@color/roomly_surface"
                    android:backgroundTint="@color/roomly_primary" />

            </LinearLayout>

        </ScrollView>

    </FrameLayout>

</LinearLayout>