<?xml version="1.0" encoding="utf-8"?>
<!-- Màn hình danh sách các cuộc trò chuyện. -->
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/roomly_background"
    android:paddingStart="20dp"
    android:paddingEnd="20dp">

    <!-- Tiêu đề màn hình. -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:text="Tin nhắn"
        android:textColor="@color/roomly_text_primary"
        android:textSize="26sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="Trao đổi với chủ phòng"
        android:textColor="@color/roomly_text_secondary"
        android:textSize="14sp" />

    <!-- Vùng hiển thị danh sách hoặc thông báo trống. -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="20dp">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rv_conversations"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:paddingBottom="16dp"
            android:visibility="gone" />

        <!-- Hiển thị khi chưa có cuộc trò chuyện. -->
        <LinearLayout
            android:id="@+id/layout_messages_empty"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:gravity="center"
            android:padding="24dp">

            <ImageView
                android:layout_width="64dp"
                android:layout_height="64dp"
                android:src="@drawable/ic_chat"
                android:importantForAccessibility="no"
                app:tint="@color/roomly_primary" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:gravity="center"
                android:text="Bạn chưa có tin nhắn"
                android:textColor="@color/roomly_text_primary"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:gravity="center"
                android:lineSpacingExtra="4dp"
                android:text="Mở chi tiết một phòng và bấm Nhắn tin để bắt đầu trao đổi."
                android:textColor="@color/roomly_text_secondary"
                android:textSize="14sp" />

        </LinearLayout>

    </FrameLayout>

</LinearLayout>