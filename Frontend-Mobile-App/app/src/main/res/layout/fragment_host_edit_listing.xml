<?xml version="1.0" encoding="utf-8"?>
<!-- Chỉnh sửa bản nháp bài đăng; giữ nguyên phòng liên kết. -->
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/roomly_background"
    android:focusableInTouchMode="true">

    <!-- Thanh tiêu đề và nút quay lại. -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="12dp"
        android:paddingEnd="20dp"
        android:paddingTop="12dp"
        android:paddingBottom="12dp">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_edit_listing_back"
            style="@style/Widget.MaterialComponents.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minWidth="48dp"
            android:minHeight="48dp"
            android:text="Quay lại"
            android:textAllCaps="false"
            android:textColor="@color/roomly_primary" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="12dp"
            android:text="Sửa bản nháp"
            android:textColor="@color/roomly_text_primary"
            android:textSize="24sp"
            android:textStyle="bold" />

    </LinearLayout>

    <!-- Biểu mẫu cuộn khi bàn phím mở. -->
    <androidx.core.widget.NestedScrollView
        android:id="@+id/scroll_edit_listing"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true"
        android:clipToPadding="false"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingBottom="24dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Lỗi truy cập hoặc lỗi lưu thay đổi. -->
            <TextView
                android:id="@+id/tv_edit_listing_error"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:layout_marginBottom="16dp"
                android:accessibilityLiveRegion="polite"
                android:textColor="?attr/colorError"
                android:textSize="14sp"
                android:visibility="gone" />

            <!-- Chỉ hiện khi bản nháp và quyền truy cập hợp lệ. -->
            <LinearLayout
                android:id="@+id/layout_edit_listing_form"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <!-- Phòng liên kết chỉ được hiển thị, không chọn lại. -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:cardBackgroundColor="@color/roomly_surface"
                    app:cardCornerRadius="20dp"
                    app:cardElevation="0dp"
                    app:strokeColor="@color/roomly_border"
                    app:strokeWidth="1dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="20dp">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Phòng liên kết"
                            android:textColor="@color/roomly_text_secondary"
                            android:textSize="13sp" />

                        <TextView
                            android:id="@+id/tv_edit_listing_room_code"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:textColor="@color/roomly_primary"
                            android:textSize="14sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tv_edit_listing_room_name"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="6dp"
                            android:textColor="@color/roomly_text_primary"
                            android:textSize="18sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="10dp"
                            android:text="Ảnh và thông tin phòng được quản lý trong Phòng của tôi."
                            android:textColor="@color/roomly_text_secondary"
                            android:textSize="13sp"
                            android:lineSpacingExtra="3dp" />

                    </LinearLayout>

                </com.google.android.material.card.MaterialCardView>

                <!-- Tiêu đề bản nháp. -->
                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/input_edit_listing_title"
                    style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="24dp"
                    android:hint="Tiêu đề bài đăng"
                    app:boxBackgroundColor="@color/roomly_surface"
                    app:boxCornerRadiusTopStart="12dp"
                    app:boxCornerRadiusTopEnd="12dp"
                    app:boxCornerRadiusBottomStart="12dp"
                    app:boxCornerRadiusBottomEnd="12dp">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/edt_edit_listing_title"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="textCapSentences"
                        android:maxLines="1"
                        android:imeOptions="actionNext"
                        android:textColor="@color/roomly_text_primary"
                        android:textSize="16sp" />

                </com.google.android.material.textfield.TextInputLayout>

                <!-- Giá thuê mỗi tháng bằng đồng Việt Nam. -->
                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/input_edit_listing_price"
                    style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:hint="Giá thuê mỗi tháng"
                    app:suffixText="₫"
                    app:helperText="Nhập số không có dấu phân cách, ví dụ 3500000."
                    app:boxBackgroundColor="@color/roomly_surface"
                    app:boxCornerRadiusTopStart="12dp"
                    app:boxCornerRadiusTopEnd="12dp"
                    app:boxCornerRadiusBottomStart="12dp"
                    app:boxCornerRadiusBottomEnd="12dp">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/edt_edit_listing_price"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="number"
                        android:maxLines="1"
                        android:imeOptions="actionNext"
                        android:textColor="@color/roomly_text_primary"
                        android:textSize="16sp" />

                </com.google.android.material.textfield.TextInputLayout>

                <!-- Nội dung bài đăng. -->
                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/input_edit_listing_description"
                    style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:hint="Nội dung bài đăng"
                    app:boxBackgroundColor="@color/roomly_surface"
                    app:boxCornerRadiusTopStart="12dp"
                    app:boxCornerRadiusTopEnd="12dp"
                    app:boxCornerRadiusBottomStart="12dp"
                    app:boxCornerRadiusBottomEnd="12dp">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/edt_edit_listing_description"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:minLines="5"
                        android:gravity="top|start"
                        android:inputType="textCapSentences|textMultiLine"
                        android:imeOptions="actionDone"
                        android:textColor="@color/roomly_text_primary"
                        android:textSize="16sp" />

                </com.google.android.material.textfield.TextInputLayout>

                <!-- Trạng thái xử lý cập nhật. -->
                <ProgressBar
                    android:id="@+id/progress_edit_listing"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:layout_gravity="center_horizontal"
                    android:layout_marginTop="16dp"
                    android:visibility="gone" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_edit_listing_save"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:minHeight="48dp"
                    android:text="Lưu thay đổi"
                    android:textAllCaps="false"
                    android:textColor="@color/roomly_surface"
                    app:backgroundTint="@color/roomly_primary"
                    app:cornerRadius="12dp" />

            </LinearLayout>

        </LinearLayout>

    </androidx.core.widget.NestedScrollView>

</LinearLayout>