<?xml version="1.0" encoding="utf-8"?>
<!-- Thẻ bản nháp bài đăng trong phần quản lý của chủ trọ. -->
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="16dp"
    app:cardBackgroundColor="@color/roomly_surface"
    app:cardCornerRadius="20dp"
    app:cardElevation="0dp"
    app:strokeColor="@color/roomly_border"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Ảnh lấy từ phòng liên kết với bản nháp. -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="180dp"
            android:background="@color/roomly_primary_light">

            <ImageView
                android:id="@+id/img_host_listing"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="centerCrop"
                android:contentDescription="Ảnh phòng của bài đăng"
                android:visibility="gone" />

            <TextView
                android:id="@+id/tv_host_listing_image_placeholder"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:text="Chưa có ảnh phòng"
                android:textColor="@color/roomly_primary"
                android:textSize="14sp" />

        </FrameLayout>

        <!-- Nội dung bài đăng. -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <!-- Trạng thái hiện tại của dữ liệu mẫu. -->
            <TextView
                android:id="@+id/tv_host_listing_status"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@color/roomly_primary_light"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:paddingTop="6dp"
                android:paddingBottom="6dp"
                android:text="Bản nháp mẫu"
                android:textColor="@color/roomly_primary"
                android:textSize="12sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tv_host_listing_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:maxLines="2"
                android:ellipsize="end"
                android:textColor="@color/roomly_text_primary"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tv_host_listing_price"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:textColor="@color/roomly_primary"
                android:textSize="18sp"
                android:textStyle="bold" />

            <!-- Mã phòng liên kết giúp chủ trọ nhận diện bài đăng. -->
            <TextView
                android:id="@+id/tv_host_listing_room_code"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:textColor="@color/roomly_text_secondary"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/tv_host_listing_address"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:maxLines="2"
                android:ellipsize="end"
                android:textColor="@color/roomly_text_secondary"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/tv_host_listing_description"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:maxLines="3"
                android:ellipsize="end"
                android:lineSpacingExtra="3dp"
                android:textColor="@color/roomly_text_secondary"
                android:textSize="14sp" />

        </LinearLayout>

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>