<?xml version="1.0" encoding="utf-8"?>
<!-- Chi tiết bài đăng dành cho tài khoản ADMIN. -->
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/roomly_background">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="12dp"
        android:paddingEnd="20dp"
        android:paddingVertical="12dp">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_admin_detail_back"
            style="@style/Widget.MaterialComponents.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minHeight="48dp"
            android:text="Quay lại"
            android:textAllCaps="false"
            android:textColor="@color/roomly_primary" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:text="Chi tiết bài đăng"
            android:textSize="22sp"
            android:textStyle="bold"
            android:textColor="@color/roomly_text_primary" />

    </LinearLayout>

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true"
        android:clipToPadding="false"
        android:paddingHorizontal="20dp"
        android:paddingBottom="24dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Thông báo lỗi hoặc mất quyền truy cập. -->
            <TextView
                android:id="@+id/tv_admin_detail_error"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="16dp"
                android:textSize="14sp"
                android:textColor="?attr/colorError"
                android:accessibilityLiveRegion="polite"
                android:visibility="gone" />

            <LinearLayout
                android:id="@+id/layout_admin_detail_content"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <!-- Ảnh và nội dung bài đăng. -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:cardBackgroundColor="@color/roomly_surface"
                    app:cardCornerRadius="20dp"
                    app:cardElevation="0dp"
                    app:strokeColor="@color/roomly_border"
                    app:strokeWidth="1dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">

                        <FrameLayout
                            android:layout_width="match_parent"
                            android:layout_height="210dp">

                            <ImageView
                                android:id="@+id/img_admin_detail"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:scaleType="centerCrop"
                                android:contentDescription="Ảnh bài đăng"
                                android:visibility="gone" />

                            <TextView
                                android:id="@+id/tv_admin_detail_image_placeholder"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:gravity="center"
                                android:background="@color/roomly_primary_light"
                                android:text="Chưa có ảnh bài đăng"
                                android:textColor="@color/roomly_primary" />

                        </FrameLayout>

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:padding="20dp">

                            <TextView
                                android:id="@+id/tv_admin_detail_status"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:textColor="@color/roomly_primary"
                                android:textStyle="bold"
                                android:textSize="14sp" />

                            <TextView
                                android:id="@+id/tv_admin_detail_title"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="12dp"
                                android:textColor="@color/roomly_text_primary"
                                android:textStyle="bold"
                                android:textSize="22sp" />

                            <TextView
                                android:id="@+id/tv_admin_detail_price"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="12dp"
                                android:textColor="@color/roomly_primary"
                                android:textStyle="bold"
                                android:textSize="20sp" />

                            <TextView
                                android:id="@+id/tv_admin_detail_host"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="16dp"
                                android:textColor="@color/roomly_text_primary"
                                android:textSize="14sp" />

                            <TextView
                                android:id="@+id/tv_admin_detail_room_code"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="8dp"
                                android:textColor="@color/roomly_text_secondary"
                                android:textSize="14sp" />

                            <TextView
                                android:id="@+id/tv_admin_detail_address"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="8dp"
                                android:textColor="@color/roomly_text_secondary"
                                android:textSize="14sp" />

                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="24dp"
                                android:text="Nội dung bài đăng"
                                android:textColor="@color/roomly_text_primary"
                                android:textStyle="bold"
                                android:textSize="17sp" />

                            <TextView
                                android:id="@+id/tv_admin_detail_description"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="8dp"
                                android:textColor="@color/roomly_text_secondary"
                                android:textSize="15sp"
                                android:lineSpacingExtra="4dp" />

                            <!-- Lý do xử lý gần nhất trong dữ liệu mẫu. -->
                            <TextView
                                android:id="@+id/tv_admin_detail_reason"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="20dp"
                                android:textColor="@color/roomly_text_primary"
                                android:textSize="14sp"
                                android:lineSpacingExtra="4dp"
                                android:visibility="gone" />

                        </LinearLayout>

                    </LinearLayout>

                </com.google.android.material.card.MaterialCardView>

                <!-- Chỉ hiện thao tác phù hợp với trạng thái hiện tại. -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_admin_detail_approve"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:minHeight="48dp"
                    android:text="Duyệt bài đăng"
                    android:textAllCaps="false"
                    android:textColor="@color/roomly_surface"
                    android:visibility="gone"
                    app:backgroundTint="@color/roomly_primary"
                    app:cornerRadius="12dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_admin_detail_reject"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:minHeight="48dp"
                    android:text="Từ chối bài đăng"
                    android:textAllCaps="false"
                    android:textColor="?attr/colorError"
                    android:visibility="gone"
                    app:strokeColor="?attr/colorError"
                    app:cornerRadius="12dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_admin_detail_hide"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:minHeight="48dp"
                    android:text="Ẩn bài đăng"
                    android:textAllCaps="false"
                    android:textColor="?attr/colorError"
                    android:visibility="gone"
                    app:strokeColor="?attr/colorError"
                    app:cornerRadius="12dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_admin_detail_restore"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:minHeight="48dp"
                    android:text="Khôi phục hiển thị"
                    android:textAllCaps="false"
                    android:textColor="@color/roomly_surface"
                    android:visibility="gone"
                    app:backgroundTint="@color/roomly_primary"
                    app:cornerRadius="12dp" />

            </LinearLayout>

        </LinearLayout>

    </androidx.core.widget.NestedScrollView>

</LinearLayout>