<?xml version="1.0" encoding="utf-8"?>
<!-- Chi tiết báo cáo vi phạm dành cho admin. -->
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/roomly_background">

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_report_detail_back"
        style="@style/Widget.MaterialComponents.Button.TextButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:minHeight="48dp"
        android:text="Quay lại"
        android:textAllCaps="false"
        android:textColor="@color/roomly_primary" />

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true"
        android:clipToPadding="false"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingBottom="24dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tv_report_detail_error"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="16dp"
                android:textColor="?attr/colorError"
                android:textSize="14sp"
                android:accessibilityLiveRegion="polite"
                android:visibility="gone" />

            <!-- Chỉ hiện khi truy cập được báo cáo. -->
            <LinearLayout
                android:id="@+id/layout_report_detail_content"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <TextView
                    android:id="@+id/tv_report_detail_status"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:textColor="@color/roomly_primary"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tv_report_detail_title"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:textColor="@color/roomly_text_primary"
                    android:textSize="24sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tv_report_detail_info"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:textColor="@color/roomly_text_secondary"
                    android:textSize="14sp"
                    android:lineSpacingExtra="4dp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="24dp"
                    android:text="Lý do báo cáo"
                    android:textColor="@color/roomly_text_primary"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tv_report_detail_reason"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:textColor="@color/roomly_text_secondary"
                    android:textSize="15sp"
                    android:lineSpacingExtra="4dp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="24dp"
                    android:text="Nội dung được báo cáo"
                    android:textColor="@color/roomly_text_primary"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tv_report_detail_preview"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:padding="16dp"
                    android:background="@color/roomly_surface"
                    android:textColor="@color/roomly_text_primary"
                    android:textSize="15sp"
                    android:lineSpacingExtra="4dp" />

                <!-- Hiện khi báo cáo liên kết với bài đăng truy cập được. -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_report_detail_open_listing"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:minHeight="48dp"
                    android:text="Mở bài đăng để kiểm duyệt"
                    android:textAllCaps="false"
                    android:textColor="@color/roomly_primary"
                    android:visibility="gone"
                    app:strokeColor="@color/roomly_primary"
                    app:cornerRadius="12dp" />

                <!-- Kết quả được hiển thị sau khi báo cáo đã xử lý. -->
                <TextView
                    android:id="@+id/tv_report_detail_resolution"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="24dp"
                    android:padding="16dp"
                    android:background="@color/roomly_primary_light"
                    android:textColor="@color/roomly_text_primary"
                    android:textSize="15sp"
                    android:lineSpacingExtra="4dp"
                    android:visibility="gone" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_report_detail_resolve"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="24dp"
                    android:minHeight="48dp"
                    android:text="Ghi nhận vi phạm"
                    android:textAllCaps="false"
                    android:textColor="@color/roomly_surface"
                    android:visibility="gone"
                    app:backgroundTint="@color/roomly_primary"
                    app:cornerRadius="12dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_report_detail_dismiss"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:minHeight="48dp"
                    android:text="Không ghi nhận vi phạm"
                    android:textAllCaps="false"
                    android:textColor="@color/roomly_primary"
                    android:visibility="gone"
                    app:strokeColor="@color/roomly_primary"
                    app:cornerRadius="12dp" />

            </LinearLayout>

        </LinearLayout>

    </androidx.core.widget.NestedScrollView>

</LinearLayout>