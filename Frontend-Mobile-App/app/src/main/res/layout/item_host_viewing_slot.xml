<?xml version="1.0" encoding="utf-8"?>
<!-- Thẻ hiển thị ngày, khoảng thời gian và trạng thái khung giờ. -->
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    app:cardBackgroundColor="@color/roomly_surface"
    app:cardCornerRadius="16dp"
    app:cardElevation="0dp"
    app:strokeColor="@color/roomly_border"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Ngày xem phòng. -->
        <TextView
            android:id="@+id/tv_host_slot_date"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/roomly_text_primary"
            android:textSize="17sp"
            android:textStyle="bold" />

        <!-- Hiển thị cả ngày và giờ để nhận biết khung giờ qua ngày. -->
        <TextView
            android:id="@+id/tv_host_slot_time"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:textColor="@color/roomly_text_secondary"
            android:textSize="14sp"
            android:lineSpacingExtra="3dp" />

        <!-- Trạng thái sẽ được Adapter cập nhật theo dữ liệu và thời gian. -->
        <TextView
            android:id="@+id/tv_host_slot_status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:textColor="@color/roomly_primary"
            android:textSize="13sp"
            android:textStyle="bold" />

        <!-- Nút đổi trạng thái mở hoặc đóng nhận lịch. -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_host_slot_toggle"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:minHeight="48dp"
            android:text="Đóng nhận lịch"
            android:textAllCaps="false"
            android:textColor="@color/roomly_primary"
            app:strokeColor="@color/roomly_primary"
            app:cornerRadius="12dp" />

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>