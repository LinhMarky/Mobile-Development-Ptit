<?xml version="1.0" encoding="utf-8"?>
<!-- Giao diện quản lý các phòng thuộc tài khoản chủ trọ. -->
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/roomly_background"
    android:paddingStart="20dp"
    android:paddingEnd="20dp">

    <!-- Tiêu đề và mô tả màn hình. -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:text="Phòng của tôi"
        android:textColor="@color/roomly_text_primary"
        android:textSize="26sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="Quản lý thông tin phòng và bài đăng cho thuê."
        android:textColor="@color/roomly_text_secondary"
        android:textSize="14sp" />

    <!-- Nút tạo phòng; sẽ được nối với màn hình nhập thông tin. -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_host_add_room"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:minHeight="48dp"
        android:text="Thêm phòng"
        android:textAllCaps="false"
        android:textColor="@color/roomly_surface"
        app:backgroundTint="@color/roomly_primary"
        app:cornerRadius="12dp" />

    <!-- Mở danh sách yêu cầu xem phòng gửi đến chủ trọ. -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_host_open_appointments"
        style="@style/Widget.MaterialComponents.Button.OutlinedButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:minHeight="48dp"
        android:text="Yêu cầu xem phòng"
        android:textAllCaps="false"
        android:textColor="@color/roomly_primary"
        android:visibility="gone"
        app:strokeColor="@color/roomly_primary"
        app:cornerRadius="12dp" />

    <!-- Vùng hiển thị danh sách hoặc trạng thái của màn hình. -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="16dp">

        <!-- Danh sách sẽ được nối với dữ liệu phòng của chủ trọ. -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rv_host_rooms"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:paddingBottom="16dp"
            android:clipToPadding="false"
            android:visibility="gone" />

        <!-- Nội dung trạng thái có thể cuộn trên màn hình nhỏ. -->
        <androidx.core.widget.NestedScrollView
            android:id="@+id/layout_host_rooms_status"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true"
            android:clipToPadding="false"
            android:paddingBottom="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center"
                android:padding="24dp">

                <!-- Tiêu đề trạng thái được cập nhật trong Fragment. -->
                <TextView
                    android:id="@+id/tv_host_rooms_status_title"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:text="Quản lý phòng cho thuê"
                    android:textColor="@color/roomly_text_primary"
                    android:textSize="20sp"
                    android:textStyle="bold" />

                <!-- Chưa kết nối dữ liệu nên chưa kết luận danh sách trống. -->
                <TextView
                    android:id="@+id/tv_host_rooms_status_description"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:gravity="center"
                    android:lineSpacingExtra="4dp"
                    android:text="Danh sách phòng sẽ hiển thị khi kết nối dữ liệu."
                    android:textColor="@color/roomly_text_secondary"
                    android:textSize="14sp" />

                <!-- Dùng khi cần đăng nhập hoặc xác minh email. -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_host_rooms_access"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:minHeight="48dp"
                    android:text="Đăng nhập"
                    android:textAllCaps="false"
                    android:textColor="@color/roomly_surface"
                    android:visibility="gone"
                    app:backgroundTint="@color/roomly_primary"
                    app:cornerRadius="12dp" />

            </LinearLayout>

        </androidx.core.widget.NestedScrollView>

    </FrameLayout>

</LinearLayout>