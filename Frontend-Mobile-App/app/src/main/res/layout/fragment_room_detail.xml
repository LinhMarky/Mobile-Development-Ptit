<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/roomly_background">

    <!-- Nội dung cuộn kết thúc phía trên vùng nút thao tác. -->
    <androidx.core.widget.NestedScrollView
        android:id="@+id/scroll_room_detail"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:fillViewport="true"
        android:clipToPadding="false"
        android:paddingBottom="24dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toTopOf="@+id/layout_detail_actions"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Ảnh được gán trong Java; không dùng ảnh phòng mặc định. -->
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="280dp"
                android:background="@color/roomly_primary_light">

                <ImageView
                    android:id="@+id/img_room_detail"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@color/roomly_primary_light"
                    android:scaleType="centerCrop"
                    android:contentDescription="Ảnh chi tiết phòng" />

                <!-- Nút quay lại đặt trên vùng ảnh. -->
                <androidx.appcompat.widget.AppCompatImageButton
                    android:id="@+id/btn_back"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:layout_gravity="top|start"
                    android:layout_margin="16dp"
                    android:background="@drawable/bg_favorite_button"
                    android:src="@drawable/ic_arrow_back"
                    android:scaleType="centerInside"
                    android:padding="12dp"
                    android:contentDescription="Quay lại"
                    app:backgroundTint="@null" />

            </FrameLayout>

            <!-- Dữ liệu phòng được cập nhật từ bài đăng công khai. -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">

                <TextView
                    android:id="@+id/tv_detail_title"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Chi tiết phòng"
                    android:textColor="@color/roomly_text_primary"
                    android:textSize="24sp"
                    android:textStyle="bold"
                    android:accessibilityHeading="true" />

                <!-- Giá thuê theo tháng. -->
                <TextView
                    android:id="@+id/tv_detail_price"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text=""
                    android:textColor="@color/roomly_primary"
                    android:textSize="22sp"
                    android:textStyle="bold" />

                <!-- Địa chỉ kèm biểu tượng vị trí. -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:src="@drawable/ic_location"
                        android:importantForAccessibility="no" />

                    <TextView
                        android:id="@+id/tv_detail_address"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="8dp"
                        android:text=""
                        android:textColor="@color/roomly_text_secondary"
                        android:textSize="14sp" />

                </LinearLayout>

                <!-- Thông tin ngắn về phòng, diện tích và tiện ích. -->
                <TextView
                    android:id="@+id/tv_detail_amenities"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:text=""
                    android:textColor="@color/roomly_text_primary"
                    android:textSize="14sp"
                    android:lineSpacingExtra="4dp" />

                <!-- Mô tả lấy từ bài đăng được chọn. -->
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="28dp"
                    android:text="Giới thiệu phòng"
                    android:textColor="@color/roomly_text_primary"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:accessibilityHeading="true" />

                <TextView
                    android:id="@+id/tv_detail_description"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="Chưa cung cấp mô tả"
                    android:textColor="@color/roomly_text_secondary"
                    android:textSize="14sp"
                    android:lineSpacingExtra="6dp" />

                <!-- Không tự gán giá khi chưa có dữ liệu chi phí. -->
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="28dp"
                    android:text="Chi phí khác"
                    android:textColor="@color/roomly_text_primary"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:accessibilityHeading="true" />

                <!-- Chi phí điện. -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Tiền điện"
                        android:textColor="@color/roomly_text_secondary"
                        android:textSize="14sp" />

                    <TextView
                        android:id="@+id/tv_detail_electricity"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="12dp"
                        android:gravity="end"
                        android:text="Chưa cung cấp"
                        android:textColor="@color/roomly_text_primary"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                </LinearLayout>

                <!-- Chi phí nước. -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Tiền nước"
                        android:textColor="@color/roomly_text_secondary"
                        android:textSize="14sp" />

                    <TextView
                        android:id="@+id/tv_detail_water"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="12dp"
                        android:gravity="end"
                        android:text="Chưa cung cấp"
                        android:textColor="@color/roomly_text_primary"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                </LinearLayout>

                <!-- Chi phí Internet. -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Internet"
                        android:textColor="@color/roomly_text_secondary"
                        android:textSize="14sp" />

                    <TextView
                        android:id="@+id/tv_detail_internet"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="12dp"
                        android:gravity="end"
                        android:text="Chưa cung cấp"
                        android:textColor="@color/roomly_text_primary"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                </LinearLayout>

                <!-- Thông tin người đăng bài. -->
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="28dp"
                    android:text="Người cho thuê"
                    android:textColor="@color/roomly_text_primary"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:accessibilityHeading="true" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageView
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:background="@drawable/bg_favorite_button"
                        android:padding="12dp"
                        android:src="@drawable/ic_person"
                        android:importantForAccessibility="no" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="12dp"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/tv_detail_landlord_name"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Chưa cung cấp"
                            android:textColor="@color/roomly_text_primary"
                            android:textSize="16sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:text="Người đăng tin"
                            android:textColor="@color/roomly_text_secondary"
                            android:textSize="13sp" />

                    </LinearLayout>

                </LinearLayout>

            </LinearLayout>

        </LinearLayout>

    </androidx.core.widget.NestedScrollView>

    <!-- Các nút cố định ở cuối màn hình, không che nội dung cuộn. -->
    <LinearLayout
        android:id="@+id/layout_detail_actions"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:background="@color/roomly_surface"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="16dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_detail_message"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginEnd="12dp"
            android:minHeight="48dp"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:text="Nhắn tin"
            android:textAllCaps="false"
            android:textColor="@color/roomly_primary"
            android:textSize="14sp"
            app:backgroundTint="@color/roomly_surface"
            app:cornerRadius="12dp"
            app:strokeColor="@color/roomly_primary"
            app:strokeWidth="1dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_detail_schedule"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1.5"
            android:minHeight="48dp"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:text="Đặt lịch xem phòng"
            android:textAllCaps="false"
            android:textColor="@color/roomly_surface"
            android:textSize="14sp"
            app:backgroundTint="@color/roomly_primary"
            app:cornerRadius="12dp" />

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>