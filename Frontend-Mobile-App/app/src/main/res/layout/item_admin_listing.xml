<?xml version="1.0" encoding="utf-8"?>
<!-- Thẻ bài đăng trong danh sách quản trị. -->
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="16dp"
    app:cardBackgroundColor="@color/roomly_surface"
    app:cardCornerRadius="20dp"
    app:cardElevation="0dp"
    app:strokeColor="@color/roomly_border"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Ảnh bài đăng hoặc thông báo khi chưa có ảnh. -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="170dp">

            <ImageView
                android:id="@+id/img_admin_listing"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="centerCrop"
                android:contentDescription="Ảnh bài đăng"
                android:visibility="gone" />

            <TextView
                android:id="@+id/tv_admin_listing_image_placeholder"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:background="@color/roomly_primary_light"
                android:text="Chưa có ảnh bài đăng"
                android:textColor="@color/roomly_primary"
                android:textSize="14sp" />

        </FrameLayout>

        <!-- Thông tin phục vụ xem xét bài đăng. -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:id="@+id/tv_admin_listing_status"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/roomly_primary"
                android:textSize="13sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tv_admin_listing_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:textColor="@color/roomly_text_primary"
                android:textSize="17sp"
                android:textStyle="bold"
                android:maxLines="2"
                android:ellipsize="end" />

            <TextView
                android:id="@+id/tv_admin_listing_price"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:textColor="@color/roomly_primary"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tv_admin_listing_host"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:textColor="@color/roomly_text_primary"
                android:textSize="14sp"
                android:maxLines="2"
                android:ellipsize="end" />

            <TextView
                android:id="@+id/tv_admin_listing_room_code"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:textColor="@color/roomly_text_secondary"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/tv_admin_listing_address"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:textColor="@color/roomly_text_secondary"
                android:textSize="14sp"
                android:maxLines="2"
                android:ellipsize="end" />

            <!-- Nút mở chi tiết để đọc đầy đủ trước khi kiểm duyệt. -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_admin_listing_detail"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:minHeight="48dp"
                android:text="Xem chi tiết"
                android:textAllCaps="false"
                android:textColor="@color/roomly_primary"
                app:strokeColor="@color/roomly_primary"
                app:cornerRadius="12dp" />

        </LinearLayout>

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>