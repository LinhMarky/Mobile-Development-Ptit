<?xml version="1.0" encoding="utf-8"?>
<!-- Biểu mẫu chỉnh sửa phòng; mã phòng chỉ được hiển thị. -->
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/roomly_background"
    android:focusableInTouchMode="true">

    <!-- Thanh tiêu đề và nút quay lại. -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="12dp"
        android:paddingEnd="20dp"
        android:paddingTop="12dp"
        android:paddingBottom="12dp">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_edit_room_back"
            style="@style/Widget.MaterialComponents.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minWidth="48dp"
            android:minHeight="48dp"
            android:text="Quay lại"
            android:textAllCaps="false"
            android:textColor="@color/roomly_primary" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="12dp"
            android:text="Chỉnh sửa phòng"
            android:textColor="@color/roomly_text_primary"
            android:textSize="22sp"
            android:textStyle="bold" />

    </LinearLayout>

    <!-- Biểu mẫu cuộn khi bàn phím mở hoặc màn hình nhỏ. -->
    <androidx.core.widget.NestedScrollView
        android:id="@+id/scroll_edit_room"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true"
        android:clipToPadding="false"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingBottom="24dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Thông báo lỗi hoặc không có quyền truy cập. -->
            <TextView
                android:id="@+id/tv_edit_room_error"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:layout_marginBottom="16dp"
                android:accessibilityLiveRegion="polite"
                android:textColor="?attr/colorError"
                android:textSize="14sp"
                android:visibility="gone" />

            <!-- Chỉ hiện khi phòng và quyền truy cập hợp lệ. -->
            <LinearLayout
                android:id="@+id/layout_edit_room_form"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <!-- Mã phòng không được sửa sau khi tạo. -->
                <TextView
                    android:id="@+id/tv_edit_room_code"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="@color/roomly_primary"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:layout_marginBottom="20dp"
                    android:text="Mã phòng được giữ nguyên sau khi tạo."
                    android:textColor="@color/roomly_text_secondary"
                    android:textSize="13sp" />

                <!-- Ảnh hiện tại và nút đổi ảnh. -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="20dp"
                    app:cardBackgroundColor="@color/roomly_surface"
                    app:cardCornerRadius="16dp"
                    app:cardElevation="0dp"
                    app:strokeColor="@color/roomly_border"
                    app:strokeWidth="1dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">

                        <ImageView
                            android:id="@+id/img_edit_room_preview"
                            android:layout_width="match_parent"
                            android:layout_height="180dp"
                            android:background="@color/roomly_primary_light"
                            android:scaleType="centerCrop"
                            android:contentDescription="Ảnh phòng"
                            android:visibility="gone" />

                        <TextView
                            android:id="@+id/tv_edit_room_image_placeholder"
                            android:layout_width="match_parent"
                            android:layout_height="140dp"
                            android:background="@color/roomly_primary_light"
                            android:gravity="center"
                            android:text="Chưa có ảnh phòng"
                            android:textColor="@color/roomly_primary"
                            android:textSize="14sp" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btn_edit_room_select_image"
                            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_margin="12dp"
                            android:minHeight="48dp"
                            android:text="Chọn ảnh"
                            android:textAllCaps="false"
                            android:textColor="@color/roomly_primary"
                            app:strokeColor="@color/roomly_primary"
                            app:cornerRadius="12dp" />

                    </LinearLayout>

                </com.google.android.material.card.MaterialCardView>

                <!-- Tên phòng. -->
                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/input_edit_room_name"
                    style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="Tên phòng"
                    app:boxBackgroundColor="@color/roomly_surface"
                    app:boxCornerRadiusTopStart="12dp"
                    app:boxCornerRadiusTopEnd="12dp"
                    app:boxCornerRadiusBottomStart="12dp"
                    app:boxCornerRadiusBottomEnd="12dp">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/edt_edit_room_name"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="textCapSentences"
                        android:maxLines="1"
                        android:imeOptions="actionNext"
                        android:textColor="@color/roomly_text_primary"
                        android:textSize="16sp" />

                </com.google.android.material.textfield.TextInputLayout>

                <!-- Địa chỉ phòng. -->
                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/input_edit_room_address"
                    style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:hint="Địa chỉ"
                    app:boxBackgroundColor="@color/roomly_surface"
                    app:boxCornerRadiusTopStart="12dp"
                    app:boxCornerRadiusTopEnd="12dp"
                    app:boxCornerRadiusBottomStart="12dp"
                    app:boxCornerRadiusBottomEnd="12dp">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/edt_edit_room_address"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="textPostalAddress"
                        android:maxLines="1"
                        android:imeOptions="actionNext"
                        android:textColor="@color/roomly_text_primary"
                        android:textSize="16sp" />

                </com.google.android.material.textfield.TextInputLayout>

                <!-- Diện tích phòng. -->
                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/input_edit_room_area"
                    style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:hint="Diện tích"
                    app:suffixText="m²"
                    app:boxBackgroundColor="@color/roomly_surface"
                    app:boxCornerRadiusTopStart="12dp"
                    app:boxCornerRadiusTopEnd="12dp"
                    app:boxCornerRadiusBottomStart="12dp"
                    app:boxCornerRadiusBottomEnd="12dp">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/edt_edit_room_area"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="numberDecimal"
                        android:maxLines="1"
                        android:imeOptions="actionNext"
                        android:textColor="@color/roomly_text_primary"
                        android:textSize="16sp" />

                </com.google.android.material.textfield.TextInputLayout>

                <!-- Mô tả phòng có thể nhập nhiều dòng. -->
                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/input_edit_room_description"
                    style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:hint="Mô tả phòng"
                    app:boxBackgroundColor="@color/roomly_surface"
                    app:boxCornerRadiusTopStart="12dp"
                    app:boxCornerRadiusTopEnd="12dp"
                    app:boxCornerRadiusBottomStart="12dp"
                    app:boxCornerRadiusBottomEnd="12dp">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/edt_edit_room_description"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:minLines="4"
                        android:gravity="top|start"
                        android:inputType="textCapSentences|textMultiLine"
                        android:imeOptions="actionDone"
                        android:textColor="@color/roomly_text_primary"
                        android:textSize="16sp" />

                </com.google.android.material.textfield.TextInputLayout>

                <!-- Hiển thị khi đang xử lý cập nhật. -->
                <ProgressBar
                    android:id="@+id/progress_edit_room"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:layout_gravity="center_horizontal"
                    android:layout_marginTop="16dp"
                    android:visibility="gone" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_edit_room_save"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:minHeight="48dp"
                    android:text="Lưu thay đổi"
                    android:textAllCaps="false"
                    android:textColor="@color/roomly_surface"
                    app:backgroundTint="@color/roomly_primary"
                    app:cornerRadius="12dp" />

            </LinearLayout>

        </LinearLayout>

    </androidx.core.widget.NestedScrollView>

</LinearLayout>