<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="16dp"
    app:cardBackgroundColor="@color/roomly_surface"
    app:cardCornerRadius="20dp"
    app:cardElevation="0dp"
    app:strokeColor="@color/roomly_border"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Ảnh và thông tin phòng được hẹn xem -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <com.google.android.material.card.MaterialCardView
                android:layout_width="80dp"
                android:layout_height="80dp"
                app:cardCornerRadius="12dp"
                app:cardElevation="0dp">

                <ImageView
                    android:id="@+id/img_appointment_room"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:src="@drawable/room_demo_01"
                    android:scaleType="centerCrop"
                    android:contentDescription="Ảnh phòng hẹn xem" />

            </com.google.android.material.card.MaterialCardView>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="12dp"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tv_appointment_room_title"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Phòng studio sáng thoáng, có ban công"
                    android:textColor="@color/roomly_text_primary"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:maxLines="2"
                    android:ellipsize="end" />

                <TextView
                    android:id="@+id/tv_appointment_address"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="Mộ Lao, Hà Đông, Hà Nội"
                    android:textColor="@color/roomly_text_secondary"
                    android:textSize="13sp"
                    android:maxLines="2"
                    android:ellipsize="end" />

            </LinearLayout>

        </LinearLayout>

        <!-- Thời gian xem phòng -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:src="@drawable/ic_calendar"
                android:importantForAccessibility="no" />

            <TextView
                android:id="@+id/tv_appointment_time"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="8dp"
                android:text="09:00 · 10/10/2026"
                android:textColor="@color/roomly_primary"
                android:textSize="14sp"
                android:textStyle="bold" />

        </LinearLayout>

        <!-- Adapter sẽ ẩn lời nhắn nếu người dùng để trống -->
        <TextView
            android:id="@+id/tv_appointment_note"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Lời nhắn: Tôi muốn xem phòng và khu vực để xe."
            android:textColor="@color/roomly_text_secondary"
            android:textSize="13sp"
            android:lineSpacingExtra="4dp" />

        <!-- Nút hủy lịch mẫu -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_cancel_appointment"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="end"
            android:layout_marginTop="12dp"
            android:minHeight="48dp"
            android:text="Hủy lịch"
            android:textAllCaps="false"
            android:textSize="13sp"
            android:textColor="@color/roomly_primary"
            app:backgroundTint="@color/roomly_surface"
            app:cornerRadius="12dp"
            app:strokeColor="@color/roomly_border"
            app:strokeWidth="1dp" />

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>