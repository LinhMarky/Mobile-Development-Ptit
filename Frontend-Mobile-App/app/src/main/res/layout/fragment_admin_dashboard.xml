<?xml version="1.0" encoding="utf-8"?>
<!-- Trang quản trị. Fragment sẽ kiểm tra quyền ADMIN trước khi hiện nội dung. -->
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/roomly_background">

    <!-- Tiêu đề và nút quay lại. -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="12dp"
        android:paddingEnd="20dp"
        android:paddingTop="12dp"
        android:paddingBottom="12dp">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_admin_back"
            style="@style/Widget.MaterialComponents.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minHeight="48dp"
            android:text="Quay lại"
            android:textAllCaps="false"
            android:textColor="@color/roomly_primary" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:text="Quản trị ROOMLY"
            android:textColor="@color/roomly_text_primary"
            android:textSize="22sp"
            android:textStyle="bold" />

    </LinearLayout>

    <!-- Vùng nội dung có thể cuộn trên màn hình nhỏ. -->
    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true"
        android:clipToPadding="false"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingBottom="24dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Hiển thị khi chưa đăng nhập hoặc không có quyền admin. -->
            <TextView
                android:id="@+id/tv_admin_access_error"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:padding="16dp"
                android:text="Tài khoản hiện tại không có quyền quản trị."
                android:textColor="?attr/colorError"
                android:textSize="15sp"
                android:lineSpacingExtra="4dp"
                android:accessibilityLiveRegion="polite"
                android:visibility="gone" />

            <!-- Chỉ hiện sau khi Fragment kiểm tra quyền ADMIN. -->
            <LinearLayout
                android:id="@+id/layout_admin_content"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:text="Trung tâm quản trị"
                    android:textColor="@color/roomly_text_primary"
                    android:textSize="26sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="Kiểm duyệt nội dung và theo dõi hoạt động của ứng dụng."
                    android:textColor="@color/roomly_text_secondary"
                    android:textSize="14sp"
                    android:lineSpacingExtra="4dp" />

                <!-- Nhóm chức năng kiểm duyệt nội dung. -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="24dp"
                    app:cardBackgroundColor="@color/roomly_surface"
                    app:cardCornerRadius="20dp"
                    app:cardElevation="0dp"
                    app:strokeColor="@color/roomly_border"
                    app:strokeWidth="1dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="20dp">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Kiểm duyệt nội dung"
                            android:textColor="@color/roomly_text_primary"
                            android:textSize="18sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:text="Xem xét bài đăng và xử lý nội dung được báo cáo."
                            android:textColor="@color/roomly_text_secondary"
                            android:textSize="14sp"
                            android:lineSpacingExtra="3dp" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btn_admin_listings"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="16dp"
                            android:minHeight="48dp"
                            android:text="Kiểm duyệt bài đăng"
                            android:textAllCaps="false"
                            android:textColor="@color/roomly_surface"
                            app:backgroundTint="@color/roomly_primary"
                            app:cornerRadius="12dp" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btn_admin_reports"
                            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:minHeight="48dp"
                            android:text="Xử lý báo cáo"
                            android:textAllCaps="false"
                            android:textColor="@color/roomly_primary"
                            app:strokeColor="@color/roomly_primary"
                            app:cornerRadius="12dp" />

                    </LinearLayout>

                </com.google.android.material.card.MaterialCardView>

                <!-- Nhóm quản lý tài khoản và số liệu hoạt động. -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    app:cardBackgroundColor="@color/roomly_surface"
                    app:cardCornerRadius="20dp"
                    app:cardElevation="0dp"
                    app:strokeColor="@color/roomly_border"
                    app:strokeWidth="1dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="20dp">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Quản lý hệ thống"
                            android:textColor="@color/roomly_text_primary"
                            android:textSize="18sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:text="Quản lý tài khoản và theo dõi số liệu hoạt động."
                            android:textColor="@color/roomly_text_secondary"
                            android:textSize="14sp"
                            android:lineSpacingExtra="3dp" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btn_admin_accounts"
                            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="16dp"
                            android:minHeight="48dp"
                            android:text="Quản lý tài khoản"
                            android:textAllCaps="false"
                            android:textColor="@color/roomly_primary"
                            app:strokeColor="@color/roomly_primary"
                            app:cornerRadius="12dp" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btn_admin_metrics"
                            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:minHeight="48dp"
                            android:text="Thống kê hoạt động"
                            android:textAllCaps="false"
                            android:textColor="@color/roomly_primary"
                            app:strokeColor="@color/roomly_primary"
                            app:cornerRadius="12dp" />

                    </LinearLayout>

                </com.google.android.material.card.MaterialCardView>

            </LinearLayout>

        </LinearLayout>

    </androidx.core.widget.NestedScrollView>

</LinearLayout>